# 複製這個檔案為 .dev.vars（會被 .gitignore 排除，不會進 git）
# 本機用 `wrangler pages dev` 測試時會自動讀取這裡的變數。
# 正式站的值另外在 Cloudflare Pages 後台 Settings -> Environment variables 設定，
# 兩邊互不影響，不要把真正的 key 寫進這個 .example 檔案或 commit 進 repo。

# Gemini Flash 免費層 API key（Workers AI 額度不足或想比較品質時的備援）
GEMINI_API_KEY=

# Resend（https://resend.com）免費層的 API key，用來寄「轉真人」通知信
RESEND_API_KEY=

# 轉真人通知信要寄到哪個信箱（你自己的）
NOTIFY_EMAIL_TO=

# 寄件者地址，需是 Resend 已驗證的網域，例如 bot@qiji-skin.com
NOTIFY_EMAIL_FROM=

# FAQ 直接回定稿的相似度門檻，0~1，預設 0.6，先不用改
FAQ_MATCH_THRESHOLD=0.6
